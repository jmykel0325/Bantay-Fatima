<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only manifest overlay.

    It attaches a network security configuration that permits cleartext HTTP so the
    app can reach `php artisan serve` on the development machine (10.0.2.2 for the
    emulator, or the computer's LAN IPv4 address for a physical phone).

    This file is NOT merged into release builds, so release APKs stay HTTPS-only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
